{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProtoForge",
  "version": "0.1.0",
  "identifier": "ai.protoforge.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @protoforge/web dev",
    "beforeBuildCommand": "pnpm --filter @protoforge/web build"
  },
  "app": {
    "windows": [
      {
        "title": "ProtoForge — 原体锻炉",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "resources": [],
    "externalBin": [],
    "category": "Education",
    "shortDescription": "Gamified synthetic biology forge.",
    "longDescription": "ProtoForge: design cell-line-specific introns through a card-based gameplay."
  }
}
