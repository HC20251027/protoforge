{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProtoForge",
  "version": "0.1.0",
  "identifier": "com.protoforge.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "ProtoForge",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "ProtoForge — gamified synthetic biology crowdsourcing",
    "longDescription": "ProtoForge is a desktop game where players forge novel protein sequences through a community-driven synthetic biology pipeline. Embeds Python + ML models + Qwen2.5-7B local LLM.",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/python-bundle/python"
    ],
    "resources": [
      "../api/vendor/**",
      "../api/.venv/Lib/site-packages/proto_language/**"
    ],
    "publisher": "ProtoForge",
    "copyright": "Copyright (c) 2026 ProtoForge"
  }
}
